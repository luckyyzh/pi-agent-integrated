/data/

# Local configuration and credentials. Keep the shareable template only.
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key

# Root-level dependency and build output, if added later.
/node_modules/
/.next/
*.log

# Business documents stay local; never commit them to a public repo.
/docs/

# docs-search extension dependencies are installed at setup time.
/resources/extensions/docs-search/node_modules/
/resources/extensions/docs-search/package-lock.json
