# Copy this file to .env and fill only the services you use.
# .env is ignored by Git and loaded automatically by the managed launcher.

# Optional repository-local SearXNG extension. Both values are required when enabled.
SEARXNG_URL=
SEARXNG_TOKEN=

# Optional higher Context7 quota. Context7 also works at its public unauthenticated limit.
CONTEXT7_API_KEY=

# Optional docs-search extension (project documentation retrieval).
# Drop .docx/.md/.txt documents into docs/raw/ and run /docs-index.
# Without DOCS_EMBED_BASE_URL the search runs BM25 keyword mode only.
# DOCS_DIR=docs
# DOCS_EMBED_BASE_URL=http://localhost:8000/v1
# DOCS_EMBED_MODEL=qwen3-embedding:4b
# DOCS_EMBED_API_KEY=

# Optional built-in model-provider credentials. The Web UI can also configure providers.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: move mutable runtime data while retaining the same isolation model.
# PI_AGENT_DATA_DIR=D:\path\to\pi-agent-data
